<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- ============ TOP: meter card (gauge + big dB + stats) ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/meterCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/chartCard"
        app:layout_constraintVertical_weight="1.15">

        <com.soundmeter.decibel.noisedetector.ArcGaugeView
            android:id="@+id/gauge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/a11y_gauge"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/statsRow"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintVertical_bias="0.0" />

        <ImageButton
            android:id="@+id/btnReference"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_ghost"
            android:src="@drawable/ic_info"
            android:contentDescription="@string/a11y_reference"
            android:scaleType="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/dbValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="72sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="@id/gauge"
            app:layout_constraintEnd_toEndOf="@id/gauge"
            app:layout_constraintTop_toTopOf="@id/gauge"
            app:layout_constraintBottom_toBottomOf="@id/gauge"
            app:layout_constraintVertical_bias="0.42" />

        <TextView
            android:id="@+id/dbUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/db_unit"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            app:layout_constraintStart_toStartOf="@id/dbValue"
            app:layout_constraintEnd_toEndOf="@id/dbValue"
            app:layout_constraintTop_toBottomOf="@id/dbValue"
            android:layout_marginTop="-4dp" />

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                layout="@layout/item_stat"
                android:id="@+id/statMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                layout="@layout/item_stat"
                android:id="@+id/statAvg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                layout="@layout/item_stat"
                android:id="@+id/statMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ MIDDLE: rolling chart ============ -->
    <FrameLayout
        android:id="@+id/chartCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/meterCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsRow"
        app:layout_constraintVertical_weight="0.75">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ============ BOTTOM: controls (Reset | Play/Pause | Settings) ============ -->
    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        android:layout_marginTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adView">

        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_btn_control"
            android:src="@drawable/ic_reset"
            android:contentDescription="@string/a11y_reset"
            android:scaleType="center" />

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnPauseResume"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_primary"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/btn_resume"
            android:scaleType="center" />

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_btn_control"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/a11y_settings"
            android:scaleType="center" />
    </LinearLayout>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="@string/banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
